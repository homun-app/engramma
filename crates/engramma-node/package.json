{
  "name": "engramma-node",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Node.js (N-API) binding of the Engramma memory engine",
  "license": "Apache-2.0",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "engramma",
    "targets": [
      "aarch64-apple-darwin"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "test": "node --test __test__/engine.test.js __test__/sync.test.js __test__/sync-pair.test.js",
    "test:electron": "env ELECTRON_RUN_AS_NODE=1 \"${HOMUN_ELECTRON:-node_modules/electron/dist/Electron.app/Contents/MacOS/Electron}\" --test __test__/engine.test.js __test__/sync.test.js __test__/sync-pair.test.js",
    "test:electron-main": "\"${HOMUN_ELECTRON:-node_modules/electron/dist/Electron.app/Contents/MacOS/Electron}\" __test__/electron-main.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.12"
  }
}
